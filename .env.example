# Copy to .env for local development or .env.prod for production.
PORT=3000
BACKEND_URL=http://127.0.0.1:8080
# Production: replace BACKEND_URL with the deployed backend base URL.

# Supabase project URL and public publishable key (same project as the backend).
AUTH_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
AUTH_SUPABASE_PUBLISHABLE_KEY=

# Landing-owned sign-in; configure before deploying the migration.
AUTH_LANDING_ORIGIN=https://www.acetate.me
AUTH_APP_ORIGIN=https://app.acetate.me
# Required: comma-separated invited email addresses; empty denies app access.
AUTH_ALLOWED_EMAILS=
# Enable only after Supabase passkeys/RP/origins are configured.
AUTH_CALLBACK_URL=https://www.acetate.me/?auth=callback
AUTH_PASSKEYS_ENABLED=false
RESEND_API_KEY=
REQUEST_ACCESS_NOTIFY_TO=
REQUEST_ACCESS_FROM=Acetate <onboarding@updates.acetate.me>
